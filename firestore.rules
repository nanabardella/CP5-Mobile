rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validTask() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'description', 'date', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'description', 'date', 'status', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.description is string && data.description.size() > 0 && data.description.size() <= 1000
        && data.date is string && data.date.matches('^[0-9]{2}/[0-9]{2}/[0-9]{4}$')
        && data.status in ['Pendente', 'Em andamento', 'Concluída']
        && data.createdAt is timestamp && data.updatedAt == request.time;
    }
    match /usuarios/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasAll(['name', 'email'])
        && request.resource.data.keys().hasOnly(['name', 'email'])
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email;
      match /registros/{recordId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validTask() && request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid) && validTask()
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }
  }
}
